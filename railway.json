{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt",
    "environment": {
      "PYTHON_VERSION": "3.11.0"
    }
  },
  "deploy": {
    "startCommand": "celery -A config worker --loglevel=info --pool=solo",
    "restartPolicyType": "ON_FAILURE"
  }
}
